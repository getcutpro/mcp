{
	"name": "@cutpro/mcp",
	"version": "3.0.0",
	"mcpName": "io.github.getcutpro/cutpro",
	"description": "CutPro MCP server: create images, videos, music, voices, sound effects, talking avatars and 3D with any AI model, AI characters, AI video clips, social scheduling and transcription",
	"author": "Lucas Toledo",
	"license": "MIT",
	"type": "module",
	"packageManager": "bun@1.3.14",
	"keywords": [
		"mcp",
		"model-context-protocol",
		"cutpro",
		"ai",
		"image-generation",
		"video-generation",
		"music-generation",
		"text-to-speech",
		"sound-effects",
		"talking-avatar",
		"lip-sync",
		"3d",
		"upscale",
		"background-removal",
		"ai-character",
		"ai-persona",
		"ugc",
		"veo",
		"kling",
		"seedance",
		"nano-banana",
		"suno",
		"elevenlabs",
		"clipping",
		"shorts",
		"social-media",
		"transcription"
	],
	"homepage": "https://cut.pro/docs/mcp",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/getcutpro/mcp.git"
	},
	"bugs": {
		"url": "https://github.com/getcutpro/mcp/issues"
	},
	"bin": {
		"cutpro-mcp": "dist/index.js"
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=18"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"dev": "bun run src/index.ts",
		"start": "node dist/index.js",
		"start:http": "MCP_TRANSPORT=http node dist/index.js",
		"build": "rm -rf dist && bun build src/index.ts --outdir dist --target node --minify && cp src/widget.html dist/",
		"typecheck": "bun x tsc --noEmit",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"plugin:openai": "rm -rf .plugin cutpro-openai.zip && mkdir .plugin && cp openai/plugin.json openai/mcp.json .plugin/ && cp -r plugin/skills plugin/assets .plugin/ && cd .plugin && zip -qr ../cutpro-openai.zip . && cd .. && rm -rf .plugin",
		"prepublishOnly": "bun run build"
	},
	"dependencies": {
		"@modelcontextprotocol/node": "^2.1.1",
		"@modelcontextprotocol/server": "^2.3.1",
		"@modelcontextprotocol/server-legacy": "^2.3.1",
		"express": "^5.2.1",
		"ioredis": "^6.0.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/bun": "^1.3.14",
		"@types/express": "^5.0.6",
		"@types/node": "^26.2.0",
		"prettier": "^3.9.10",
		"typescript": "^7.0.2"
	}
}
