{
	"$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
	"name": "io.github.getcutpro/cutpro",
	"title": "CutPro",
	"description": "AI images and videos with any model, AI personas, and AI clips from long videos.",
	"version": "2.4.0",
	"websiteUrl": "https://cut.pro/docs/api-reference/mcp",
	"icons": [
		{
			"src": "https://cut.pro/icons/icon-512.png",
			"mimeType": "image/png",
			"sizes": ["512x512"]
		},
		{
			"src": "https://cut.pro/icons/icon-192.png",
			"mimeType": "image/png",
			"sizes": ["192x192"]
		}
	],
	"repository": {
		"url": "https://github.com/getcutpro/mcp",
		"source": "github"
	},
	"packages": [
		{
			"registryType": "npm",
			"registryBaseUrl": "https://registry.npmjs.org",
			"identifier": "@cutpro/mcp",
			"version": "2.4.0",
			"transport": {
				"type": "stdio"
			},
			"environmentVariables": [
				{
					"name": "CUTPRO_API_KEY",
					"description": "Your CutPro API key. Generate one at https://cut.pro/studio/me/api-keys.",
					"isRequired": true,
					"isSecret": true
				},
				{
					"name": "CUTPRO_WORKSPACE_ID",
					"description": "Only needed for multi-workspace keys.",
					"isRequired": false
				}
			]
		}
	],
	"remotes": [
		{
			"type": "streamable-http",
			"url": "https://mcp.cut.pro"
		}
	]
}
