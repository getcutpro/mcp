# Local (stdio). Generate a key at https://cut.pro/studio/me/api-keys
CUTPRO_API_KEY=

# Only needed for multi-workspace keys
# CUTPRO_WORKSPACE_ID=

# Override the API base URL (defaults to https://api.cut.pro/api/v1)
# CUTPRO_API_URL=https://api.cut.pro/api/v1

# Remote transport (self-host): serve Streamable HTTP at the root instead of stdio.
# Every request must carry its own key (Authorization: Bearer or X-Api-Key).
# MCP_TRANSPORT=http
# PORT=8787

# OAuth 2.1 for browser clients (ChatGPT, Claude.ai). Requires HTTP mode.
# Users sign in on cut.pro and approve the app; MCP_PUBLIC_URL must be the server's public https URL.
# MCP_OAUTH=1
# MCP_PUBLIC_URL=https://mcp.cut.pro
# CUTPRO_APP_URL=https://cut.pro

# Back the OAuth state with Redis so it survives restarts and works across instances.
# MCP_REDIS_URL=redis://127.0.0.1:6379

# Domain verification token from the OpenAI plugin portal.
# OPENAI_APPS_CHALLENGE=
